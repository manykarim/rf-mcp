{
  "servers": {
    "rf-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${workspaceFolder}",
        "rf-mcp",
        "--mode",
        "server",
        "--transport",
        "stdio",
        "-r",
        "${workspaceFolder}"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "ROBOTCODE_FORCE_AI_AGENT": "1"
      }
    }
  }
}